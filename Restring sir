-- ======================================
-- TAB LOADER
-- ======================================
local function loadTab(url, name)
    task.spawn(function()
        local attempts = 0
        local maxAttempts = 10
        
        while attempts < maxAttempts do
            local ok, err = pcall(function()
                loadstring(game:HttpGet(url))()
            end)
            
            if ok then
                print("[Hub] ✅ " .. name)
                return
            end
            
            attempts = attempts + 1
            task.wait(0.5)
        end
        
        warn("[Hub] ❌ Failed to load: " .. name)
    end)
end

