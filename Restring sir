-- ======================================
-- FIX: Override broken CreateLabel
-- ======================================
RenoaUI.CreateLabel = function(self, text)
    local tab = self.ActiveTab
    if not tab then return end
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, 0, 0, 16)
    label.BackgroundTransparency = 1
    label.Text = tostring(text or "")
    label.TextColor3 = Color3.fromRGB(150, 150, 150)
    label.TextSize = 11
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.Parent = tab.Content
    
    label.SetText = function(self, txt)
        self.Text = tostring(txt or "")
    end
    
    return label
end

-- ======================================
-- FIX: Override broken CreateDropdown (safety)
-- ======================================
local originalCreateDropdown = RenoaUI.CreateDropdown
RenoaUI.CreateDropdown = function(self, config)
    if type(config) ~= "table" then return nil end
    
    -- Normalize CurrentOption
    if config.MultipleOptions then
        if type(config.CurrentOption) == "string" then
            config.CurrentOption = {config.CurrentOption}
        elseif type(config.CurrentOption) ~= "table" then
            config.CurrentOption = {}
        end
    else
        if type(config.CurrentOption) == "table" then
            config.CurrentOption = tostring(config.CurrentOption[1] or "")
        elseif type(config.CurrentOption) ~= "string" then
            config.CurrentOption = ""
        end
    end
    
    -- Normalize Options
    if type(config.Options) == "table" then
        for i, opt in ipairs(config.Options) do
            if type(opt) ~= "string" then
                config.Options[i] = tostring(opt)
            end
        end
    end
    
    return originalCreateDropdown(self, config)
end

